# Copy this file to .env and fill in the real values:
#     cp .env.example .env
# .env is gitignored — never commit it, it holds live secrets.

# --- Telegram bot (user-facing) ---
# From @BotFather
BOT_TOKEN=
# Comma-separated Telegram user ids allowed to moderate listings (get yours from @userinfobot)
ADMIN_TELEGRAM_IDS=
# Shared secret the bot webhook uses for its own /admin/* endpoints
ADMIN_API_TOKEN=change-me-to-a-random-string
# Shared secret the GitHub Actions scraper uses to call /internal/ingest and /admin/sources
INGEST_TOKEN=change-me-to-a-random-string-too
# Telegram echoes this back on every webhook request, proving the update really
# came from Telegram. Without it, anyone who guesses the webhook URL can forge
# an update from an admin id and approve/reject listings. Any random string.
WEBHOOK_SECRET=change-me-to-a-third-random-string

# --- Sources to monitor (comma-separated, without @) ---
# IMPORTANT: only public *channels* work — Telegram's t.me/s/<name> web preview
# that the scraper reads does not exist for groups/chats. Check by opening
# https://t.me/s/<name> in a browser: posts visible = scrapable.
# Also set as a GitHub Actions *variable* (not secret) named SOURCE_CHANNELS.
SOURCE_CHANNELS=danangrentaflat,Arenda_Nyachang_Zhilye,arenda_nhatrang,Viet_life_niachang,arenda_vietnam,onewaydanang

# --- Database ---
# SQLite for local/dev. On PythonAnywhere point it at a file in your home dir.
# Note the four slashes for an absolute path: sqlite://// + /home/...
DATABASE_URL=sqlite:///./danang_apartments.db

# --- URLs ---
# Public URL of this Flask app once deployed (e.g. https://<youruser>.pythonanywhere.com)
API_BASE_URL=http://localhost:5000
# Public URL of the docs/ static site (GitHub Pages). Telegram requires HTTPS
# for Mini App buttons — an http:// value makes it reject the whole message.
WEBAPP_URL=https://<youruser>.github.io/danang-apartments-bot/
