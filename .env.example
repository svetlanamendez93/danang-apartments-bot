# --- Telegram bot (user-facing) ---
# From @BotFather
BOT_TOKEN=
# Comma-separated Telegram user ids allowed to moderate listings (get yours from @userinfobot)
ADMIN_TELEGRAM_IDS=
# Shared secret the bot webhook uses for its own /admin/* endpoints
ADMIN_API_TOKEN=change-me-to-a-random-string
# Shared secret the GitHub Actions scraper uses to call /internal/ingest and /admin/sources
INGEST_TOKEN=change-me-to-a-random-string-too

# --- Sources to monitor (comma-separated, without @) ---
# Also set as a GitHub Actions *variable* (not secret) named SOURCE_CHANNELS, same value.
SOURCE_CHANNELS=danangrentaflat,apartmentforrentdanang,onewaydanang,vietnam_rent

# --- Database ---
# SQLite for local/dev. On PythonAnywhere just leave this pointing at a file path
# in your home directory, e.g. sqlite:////home/<youruser>/danang_apartments.db
DATABASE_URL=sqlite:///./danang_apartments.db

# --- URLs ---
# Public URL of this Flask app once deployed (e.g. https://<youruser>.pythonanywhere.com)
API_BASE_URL=http://localhost:5000
# Public URL of the webapp/ static site (e.g. GitHub Pages URL) — this is what
# the bot opens as the Mini App and what gets set in @BotFather.
WEBAPP_URL=http://localhost:5173
